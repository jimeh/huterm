      "patches": [
        {
          "name": "hidden-window-creation",
          "file": "patches/gpui-pre/hidden-window-creation.patch",
          "description": "Honor WindowOptions.show before mapping a newly created native window."
        },
        {
          "name": "file-drop-pointer-modality",
          "file": "patches/gpui-pre/file-drop-pointer-modality.patch",
          "description": "Treat external file drag movement and drops as pointer input, so a drop after typing still hit-tests its target."
        }
      ]
    },
    {
      "name": "gpui-pre-linux",
