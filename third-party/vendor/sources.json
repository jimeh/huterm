      },
      "patches": [
        {
          "name": "macos-offscreen-screen",
          "file": "patches/gpui-pre-macos/macos-offscreen-screen.patch",
          "description": "Treat a fully offscreen window as not maximized, and read its backing scale from NSWindow while it has no NSScreen."
        },
        {
          "name": "macos-offscreen-frame",
          "file": "patches/gpui-pre-macos/macos-offscreen-frame.patch",
          "description": "Expose per-window opt-in to unconstrained offscreen frames while preserving normal AppKit constraints by default."
        }
      ]
    },
