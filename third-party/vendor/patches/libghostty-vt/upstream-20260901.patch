+}
+
+impl<'t> DesktopNotification<'t> {
+    unsafe fn from_raw(raw: *const ffi::TerminalDesktopNotification) -> Self {
+        Self {
+            ptr: raw,
+            _phan: PhantomData,
+        }
+    }
