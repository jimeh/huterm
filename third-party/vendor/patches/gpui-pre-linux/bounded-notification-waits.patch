+/// Notifications that may wait for the user's response at once. Each waits
+/// on its own thread and session-bus connection until the notification
+/// closes, which a daemon that retains notifications can delay without
+/// bound. Past this many, a notification is shown without waiting, so its
+/// activation reports nothing.
+const MAX_WAITING: usize = 16;
+
+static WAITING: AtomicUsize = AtomicUsize::new(0);
+
+/// Holds one of the [`MAX_WAITING`] places until dropped.
+struct WaitSlot;
+
+impl WaitSlot {
+    fn take() -> Option<Self> {
+        WAITING
+            .try_update(Ordering::AcqRel, Ordering::Acquire, |waiting| {
+                (waiting < MAX_WAITING).then_some(waiting + 1)
+            })
+            .ok()
+            .map(|_| Self)
+    }
+}
+
+impl Drop for WaitSlot {
+    fn drop(&mut self) {
+        WAITING.fetch_sub(1, Ordering::AcqRel);
+    }
+}
