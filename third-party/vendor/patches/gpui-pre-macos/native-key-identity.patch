diff --git a/src/key_identity.rs b/src/key_identity.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cae9c9496f0ec2fdbd0135a2f8d90bedfcd7aac7
--- /dev/null
+++ b/src/key_identity.rs
@@ -0,0 +1,54 @@
+/// ANSI physical key identity, independent of the selected macOS layout.
+pub fn us_key(code: u16) -> Option<char> {
+    Some(match code {
+        0 => 'a',
+        1 => 's',
+        2 => 'd',
+        3 => 'f',
+        4 => 'h',
+        5 => 'g',
+        6 => 'z',
+        7 => 'x',
+        8 => 'c',
+        9 => 'v',
+        11 => 'b',
+        12 => 'q',
+        13 => 'w',
+        14 => 'e',
+        15 => 'r',
+        16 => 'y',
+        17 => 't',
+        18 => '1',
+        19 => '2',
+        20 => '3',
+        21 => '4',
+        22 => '6',
+        23 => '5',
+        24 => '=',
+        25 => '9',
+        26 => '7',
+        27 => '-',
+        28 => '8',
+        29 => '0',
+        30 => ']',
+        31 => 'o',
+        32 => 'u',
+        33 => '[',
+        34 => 'i',
+        35 => 'p',
+        37 => 'l',
+        38 => 'j',
+        39 => '\'',
+        40 => 'k',
+        41 => ';',
+        42 => '\\',
+        43 => ',',
+        44 => '/',
+        45 => 'n',
+        46 => 'm',
+        47 => '.',
+        49 => ' ',
+        50 => '`',
+        _ => return None,
+    })
+}
