+extern "C" fn allows_offscreen_frame(this: &AnyObject, _: Sel) -> Bool {
+    unsafe { *allows_offscreen_frame_ivar(this).load::<Bool>(this) }
+}
+
+extern "C" fn set_allows_offscreen_frame(this: &AnyObject, _: Sel, enabled: Bool) {
+    unsafe { *allows_offscreen_frame_ivar(this).load_ptr::<Bool>(this) = enabled };
+}
+
+extern "C" fn constrain_frame_rect(
+    this: &AnyObject,
+    _: Sel,
+    frame: NSRect,
+    screen: *mut AnyObject,
+) -> NSRect {
+    unsafe {
+        if allows_offscreen_frame_ivar(this).load::<Bool>(this).as_bool() {
+            frame
+        } else {
+            // Preserve NSPanel's behavior too; do not derive this from a possible
+            // dynamic subclass, whose superclass could dispatch back here.
+            let is_panel: Bool = msg_send![this, isKindOfClass: class!(NSPanel)];
+            let superclass = if is_panel.as_bool() { class!(NSPanel) } else { class!(NSWindow) };
+            msg_send![super(this, superclass), constrainFrameRect: frame, toScreen: screen]
+        }
+    }
+}
+
+fn allows_offscreen_frame_ivar(this: &AnyObject) -> &Ivar {
+    this.class()
+        .instance_variable(ALLOWS_OFFSCREEN_FRAME_IVAR)
+        .expect("GPUI offscreen-frame ivar")
+}
