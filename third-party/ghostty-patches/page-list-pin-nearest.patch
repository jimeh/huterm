+/// Returns the same pin as `pin`, but resolves a screen or history point
+/// from whichever end of the list is nearer, using the cached `total_rows`.
+/// `pin` walks from the first page, so its cost grows with history even for
+/// rows near the active area.
+///
+/// The cached count is stale inside operations such as reflow and page
+/// erasure, so only callers outside any PageList operation may use this,
+/// such as the C API. Internal callers keep using `pin`.
+pub fn pinNearest(self: *const PageList, pt: point.Point) ?Pin {
+    const result = self.pinNearestUnchecked(pt);
+    if (comptime build_options.slow_runtime_safety) {
+        if (self.pin(pt)) |expected| {
+            assert(result != null and result.?.eql(expected));
+        } else {
+            assert(result == null);
+        }
+    }
+    return result;
+}
+
+fn pinNearestUnchecked(self: *const PageList, pt: point.Point) ?Pin {
+    // Screen and history points share the first page as their origin.
+    const coord = switch (pt) {
+        .screen, .history => |v| v,
+        .active, .viewport => return self.pin(pt),
+    };
+    if (coord.x >= self.cols) return null;
+    if (coord.y >= self.total_rows) return null;
+    const from_bottom = self.total_rows - 1 - coord.y;
+    if (coord.y <= from_bottom) return self.pin(pt);
+
+    const last = self.pages.last.?;
+    const bottom: Pin = .{ .node = last, .y = last.rows() - 1 };
+    var p = bottom.up(from_bottom) orelse return null;
+    // The same narrow-page check as `pin`.
+    if (coord.x >= p.node.cols()) return null;
+    p.x = coord.x;
+    return p;
+}
