+/// Checks that `pinNearest` returns `pin`'s result for every row of the
+/// list, one row past it, and columns at, inside, and past the width.
+fn testPinNearestMatchesPin(s: *const PageList) !void {
+    const testing = std.testing;
+    const cols: size.CellCountInt = s.cols;
+    for (0..s.total_rows + 2) |y_usize| {
+        const y: u32 = @intCast(y_usize);
+        for ([_]size.CellCountInt{ 0, cols / 2, cols - 1, cols }) |x| {
+            for ([_]point.Point{
+                .{ .screen = .{ .x = x, .y = y } },
+                .{ .history = .{ .x = x, .y = y } },
+            }) |pt| {
+                const expected = s.pin(pt);
+                const actual = s.pinNearestUnchecked(pt);
+                if (expected) |e| {
+                    try testing.expect(actual != null);
+                    try testing.expect(actual.?.eql(e));
+                } else {
+                    try testing.expect(actual == null);
+                }
+            }
+        }
+    }
+}
+
+test "PageList pinNearest matches pin across pages" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 80, .rows = 24 });
+    defer s.deinit();
+    try testPinNearestMatchesPin(&s);
+
+    // Several full pages and a partly filled last page.
+    const page_rows = s.pages.first.?.page().capacity.rows;
+    for (0..page_rows * 4 + 7) |_| _ = try s.grow();
+    try testing.expect(s.totalPages() >= 5);
+    try testPinNearestMatchesPin(&s);
+
+    // Pruning history from the front shifts every screen row.
+    s.eraseRows(.{ .history = .{} }, .{ .history = .{ .y = page_rows + 3 } });
+    try testPinNearestMatchesPin(&s);
+
+    // A reflow rebuilds every page and the cached row count.
+    try s.resize(.{ .cols = 50, .reflow = true });
+    try testPinNearestMatchesPin(&s);
+}
+
+test "PageList pinNearest matches pin after a failed reflow" {
+    const testing = std.testing;
+
+    // Fail each allocation of a widening reflow in turn, until the reflow
+    // completes. Every failure must leave the cached row count correct.
+    var failures: usize = 0;
+    for (0..256) |n| {
+        var failing = testing.FailingAllocator.init(testing.allocator, .{});
+        var s = try init(failing.allocator(), .{ .cols = 80, .rows = 24 });
+        defer s.deinit();
+        const page_rows = s.pages.first.?.page().capacity.rows;
+        for (0..page_rows * 4) |_| _ = try s.grow();
+        for (0..s.total_rows) |y| {
+            const row = s.pin(.{ .screen = .{ .y = @intCast(y) } }).?;
+            row.rowAndCell().cell.* = .init('x');
+        }
+
+        failing.fail_index = failing.alloc_index + n;
+        s.resize(.{ .cols = 200, .reflow = true }) catch {
+            failures += 1;
+            try testing.expectEqual(s.totalRows(), s.total_rows);
+            try testPinNearestMatchesPin(&s);
+            continue;
+        };
+        break;
+    } else return error.ReflowNeverCompleted;
+    try testing.expect(failures > 0);
+}
+
+test "PageList pinNearest keeps the narrow page check" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 80, .rows = 24 });
+    defer s.deinit();
+    const page_rows = s.pages.first.?.page().capacity.rows;
+    for (0..page_rows * 3) |_| _ = try s.grow();
+
+    // Pages narrower than the list, as an incomplete reflow can leave them.
+    s.cols = 100;
+    defer s.cols = 80;
+    const bottom: u32 = @intCast(s.total_rows - 1);
+    try testing.expect(s.pinNearestUnchecked(.{ .screen = .{ .x = 79, .y = bottom } }) != null);
+    try testing.expect(s.pinNearestUnchecked(.{ .screen = .{ .x = 80, .y = bottom } }) == null);
+    try testPinNearestMatchesPin(&s);
+}
