+
+/// Rewrites one row with each chunk in turn. Every update must stay
+/// partial and keep the viewport's page node.
+fn testRewritesStayPartial(chunks: []const []const u8) !void {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 40,
+        .rows = 10,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+
+    var state: RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+    state.clean();
+
+    const node = t.screens.active.pages.getTopLeft(.viewport).node;
+    for (chunks) |chunk| {
+        s.nextSlice(chunk);
+        try state.update(alloc, &t);
+        try testing.expectEqual(
+            node,
+            t.screens.active.pages.getTopLeft(.viewport).node,
+        );
+        try testing.expectEqual(.partial, state.dirty);
+        state.clean();
+    }
+}
+
+test "rewriting a row with alternating hyperlinks stays partial" {
+    const link_0 = "\x1b[5;1H\x1b]8;;http://example.com/0\x07entry-0\x1b]8;;\x07";
+    const link_1 = "\x1b[5;1H\x1b]8;;http://example.com/1\x07entry-1\x1b]8;;\x07";
+    try testRewritesStayPartial(&.{ link_0, link_1, link_0, link_1, link_0, link_1 });
+}
+
+test "rewriting a row with alternating explicit-id hyperlinks stays partial" {
+    const link_0 = "\x1b[5;1H\x1b]8;id=link-0;http://example.com/0\x07entry-0\x1b]8;;\x07";
+    const link_1 = "\x1b[5;1H\x1b]8;id=link-1;http://example.com/1\x07entry-1\x1b]8;;\x07";
+    try testRewritesStayPartial(&.{ link_0, link_1, link_0, link_1, link_0, link_1 });
+}
+
+test "rewriting a row with the same implicit-id hyperlink stays partial" {
+    // Each OSC 8 start without an id takes a new implicit id, so these
+    // are distinct hyperlinks even though the URI never changes.
+    const link = "\x1b[5;1H\x1b]8;;http://example.com/0\x07entry-0\x1b]8;;\x07";
+    try testRewritesStayPartial(&.{ link, link, link, link, link, link });
+}
