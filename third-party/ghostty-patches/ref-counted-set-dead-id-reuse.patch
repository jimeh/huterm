+test "add returns OutOfMemory until enough IDs are dead to reuse" {
+    const alloc = testing.allocator;
+    const TestSet = RefCountedSet(
+        u32,
+        u16,
+        u16,
+        struct {
+            pub fn hash(_: *const @This(), value: u32) u64 {
+                return std.hash.int(value);
+            }
+
+            pub fn eql(_: *const @This(), a: u32, b: u32) bool {
+                return a == b;
+            }
+        },
+    );
+
+    const layout: TestSet.Layout = .init(16);
+    const buf = try alloc.alignedAlloc(
+        u8,
+        TestSet.base_align,
+        layout.total_size,
+    );
+    defer alloc.free(buf);
+
+    var set: TestSet = .init(.init(buf), layout, .{});
+    try testing.expectEqual(@as(usize, 13), set.layout.cap);
+
+    // Use every ID.
+    var value: u32 = 0;
+    while (set.next_id < set.layout.cap) : (value += 1) {
+        _ = try set.add(buf, value);
+    }
+    const next_id = set.next_id;
+
+    // Release IDs from the front, below live items, so the trim loop
+    // in `add` can't reap them. IDs 1 through 12 are usable. While 11
+    // or more are live, 90% of the capacity of 13, a new value doesn't
+    // fit.
+    var released: u16 = 1;
+    while (set.count() >= 11) : (released += 1) {
+        try testing.expectError(error.OutOfMemory, set.add(buf, value));
+        set.release(buf, released);
+    }
+    try testing.expectEqual(@as(usize, 10), set.count());
+
+    // With 10 live, the new value takes the lowest dead ID.
+    try testing.expectEqual(@as(u16, 1), try set.add(buf, value));
+    try testing.expectEqual(next_id, set.next_id);
+    try testing.expectEqual(@as(?u16, 1), set.lookup(buf, value));
+    try testing.expectEqual(@as(?u16, null), set.lookup(buf, 0));
+}
