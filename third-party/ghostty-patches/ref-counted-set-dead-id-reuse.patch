+
+test "add reuses dead IDs below a live item at capacity" {
+    const alloc = testing.allocator;
+    const TestSet = RefCountedSet(
+        u32,
+        u16,
+        u16,
+        struct {
+            pub fn hash(_: *const @This(), value: u32) u64 {
+                return std.hash.int(value);
+            }
+
+            pub fn eql(_: *const @This(), a: u32, b: u32) bool {
+                return a == b;
+            }
+        },
+    );
+
+    // A page's default hyperlink set: IDs 1 and 2 are usable.
+    const layout: TestSet.Layout = .init(4);
+    const buf = try alloc.alignedAlloc(
+        u8,
+        TestSet.base_align,
+        layout.total_size,
+    );
+    defer alloc.free(buf);
+
+    var set: TestSet = .init(.init(buf), layout, .{});
+
+    // Alternate two values, releasing the old one after adding the new
+    // one, as rewriting a row with a different hyperlink does. The dead
+    // ID sits below a live one, so the trim loop in `add` can't reap it.
+    var prev = try set.add(buf, 0);
+    for (1..16) |i| {
+        const value: u32 = @intCast(i);
+        const id = try set.add(buf, value);
+        set.release(buf, prev);
+
+        try testing.expect(id != prev);
+        try testing.expectEqual(@as(usize, 1), set.count());
+        try testing.expectEqual(@as(?u16, id), set.lookup(buf, value));
+        try testing.expectEqual(@as(?u16, null), set.lookup(buf, value - 1));
+        try testing.expectEqual(@as(u16, 1), set.refCount(buf, id));
+        prev = id;
+    }
+}
