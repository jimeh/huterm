+test "Screen: rewriting a hyperlink reuses dead IDs without growing the page" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var s = try init(io, alloc, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+
+    const node = s.cursor.page_pin.node;
+    const cap = node.page().hyperlink_set.layout.cap;
+
+    // Rewrite the same cells with a different hyperlink each time.
+    // Whenever the replaced link dies below the live one, the set's trim
+    // loop can't reap it, so a full set must reuse its ID rather than
+    // make the screen clone the page.
+    for (0..16) |i| {
+        var uri_buf: [32]u8 = undefined;
+        const uri = try std.fmt.bufPrint(&uri_buf, "http://example.com/{}", .{i});
+        s.cursorAbsolute(0, 0);
+        try s.startHyperlink(uri, null);
+        try s.testWriteString("link");
+        s.endHyperlink();
+
+        try testing.expectEqual(node, s.cursor.page_pin.node);
+        const page = node.page();
+        try testing.expectEqual(cap, page.hyperlink_set.layout.cap);
+        try testing.expectEqual(1, page.hyperlink_set.count());
+    }
+}
