+test "add keeps references and value ownership consistent under churn at capacity" {
+    const alloc = testing.allocator;
+
+    // Values carry a key, which the set compares, and a unique serial,
+    // which the deletion callback counts. The set owns every value handed
+    // to `add` and must delete it exactly once: right away when an equal
+    // value is already resident, or when its item is finally reaped.
+    // Hyperlink sets free page memory in this callback.
+    const TestSet = RefCountedSet(
+        u64,
+        u16,
+        u16,
+        struct {
+            deletions: []u8,
+
+            pub fn hash(_: *const @This(), value: u64) u64 {
+                return std.hash.int(value & 0xff);
+            }
+
+            pub fn eql(_: *const @This(), a: u64, b: u64) bool {
+                return a & 0xff == b & 0xff;
+            }
+
+            pub fn deleted(self: *const @This(), value: u64) void {
+                self.deletions[@intCast(value >> 8)] += 1;
+            }
+        },
+    );
+
+    // Longer probe sequences than a default hyperlink set, as in grown
+    // hyperlink sets and style sets.
+    const layout: TestSet.Layout = .init(64);
+    const buf = try alloc.alignedAlloc(
+        u8,
+        TestSet.base_align,
+        layout.total_size,
+    );
+    defer alloc.free(buf);
+
+    const ops = 4000;
+    const deletions = try alloc.alloc(u8, ops + 1);
+    defer alloc.free(deletions);
+
+    for (0..8) |seed| {
+        @memset(deletions, 0);
+        var set: TestSet = .init(.init(buf), layout, .{ .deletions = deletions });
+        var prng = std.Random.DefaultPrng.init(seed);
+        const random = prng.random();
+
+        // The expected ref count of every ID, and the key it holds.
+        var refs: [64]u16 = @splat(0);
+        var keys: [64]u64 = @splat(0);
+        var serial: u64 = 0;
+
+        for (0..ops) |_| {
+            if (random.boolean()) {
+                const key = random.uintLessThan(u64, 96);
+                const value = serial << 8 | key;
+                serial += 1;
+                const id = set.add(buf, value) catch |err| switch (err) {
+                    error.OutOfMemory => {
+                        // The set didn't take this value.
+                        deletions[@intCast(value >> 8)] += 1;
+                        continue;
+                    },
+                    error.NeedsRehash => return err,
+                };
+                if (refs[id] > 0) try testing.expectEqual(keys[id], key);
+                keys[id] = key;
+                refs[id] += 1;
+            } else {
+                const id = random.uintLessThan(u16, 64);
+                if (refs[id] == 0) continue;
+                set.release(buf, id);
+                refs[id] -= 1;
+            }
+        }
+
+        var living: usize = 0;
+        for (refs, keys, 0..) |ref, key, id| {
+            if (ref == 0) continue;
+            living += 1;
+            try testing.expectEqual(ref, set.refCount(buf, @intCast(id)));
+            try testing.expectEqual(key, set.get(buf, @intCast(id)).* & 0xff);
+        }
+        try testing.expectEqual(living, set.count());
+        var it = set.iterator(buf);
+        var iterated: usize = 0;
+        while (it.next()) |_| iterated += 1;
+        try testing.expectEqual(living, iterated);
+
+        // Release everything. The next add reaps every dead item, so each
+        // earlier value has now been deleted exactly once.
+        for (refs, 0..) |ref, id| {
+            if (ref > 0) set.releaseMultiple(buf, @intCast(id), ref);
+        }
+        _ = try set.add(buf, serial << 8);
+        for (deletions[0..serial]) |count| {
+            try testing.expectEqual(@as(u8, 1), count);
+        }
+        try testing.expectEqual(@as(u8, 0), deletions[serial]);
+    }
+}
