# Keep the previously advertised xterm-256color behavior, adding only the Tc
# truecolor flag used by consumers such as tmux. The pair limit keeps tic's portable
# 16-bit file format instead of inheriting xterm-256color's 65536 value.
xterm-huterm|Huterm terminal emulator,
	pairs#32767,
	Tc,
	use=xterm-256color,
